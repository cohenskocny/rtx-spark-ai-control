    "model_checkpoint": "D:\\models\\your-checkpoint",
    "launch_config": "C:\\path\\to\\configs\\serve.yaml",
    "chat_template": "C:\\path\\to\\configs\\chat-template.jinja",
    "blackout_engine": "",
    "blackout_python": "",
    "logs_dir": "",
    "api_host": "127.0.0.1",
